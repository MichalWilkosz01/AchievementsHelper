<UserControl x:Class="AchievementsHelper.View.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1B2838">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek z SteamID -->
        <TextBlock Grid.Row="0"
                   Text="{Binding SteamId}"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="18"
                   Margin="0 0 0 20"/>

        <!-- ComboBox wyboru gry -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0 0 0 20">

            <TextBlock Text="Wybierz grę:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Margin="0 0 10 0"/>

            <ComboBox Width="300"
          ItemsSource="{Binding Games}"
          SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
          DisplayMemberPath="Name"
          Background="#2A475E"
          Foreground="White"
          BorderBrush="#66C0F4"
          BorderThickness="1"
          Padding="4"
          FontWeight="SemiBold"/>

        </StackPanel>

        <!-- Tabela osiągnięć -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Achievements}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeColumns="False"
                  HeadersVisibility="Column"
                  Background="#1B2838"
                  Foreground="White"
                  RowBackground="#2A475E"
                  AlternatingRowBackground="#1B2838"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#66C0F4"
                  BorderThickness="1"
                  FontSize="13"
                  ColumnHeaderHeight="32"
                  RowHeight="28"
                  HorizontalGridLinesBrush="#66C0F4"
                  VerticalGridLinesBrush="#66C0F4">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2A475E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="BorderBrush" Value="#66C0F4"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush" Value="#66C0F4"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <!-- pionowa kreska z prawej -->
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa"
                                    Binding="{Binding Name}"
                                    Width="Auto" />
                <DataGridTextColumn Header="Opis"
                                    Binding="{Binding Description}"
                                    Width="2*" />
                <DataGridCheckBoxColumn Header="Odblokowane"
                                        Binding="{Binding Unlocked}"
                                        Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
